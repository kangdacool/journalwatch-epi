# .env 로 복사해서 값을 채우세요. .env 는 .gitignore 대상입니다.

# anthropic_api 백엔드를 쓸 때만 필요(claude_cli 백엔드는 Claude Code 로그인을 그대로 씀)
ANTHROPIC_API_KEY=

# Notion 다이제스트를 쓸 때만 필요. notion.so/my-integrations 에서 Internal Integration
# 생성 후 발급되는 토큰. 비워두면 Notion push가 자동으로 건너뛰어짐(로컬 마크다운 아카이브는
# Notion 설정과 무관하게 항상 동작).
NOTION_TOKEN=
